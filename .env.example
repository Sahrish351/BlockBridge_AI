# ==========================================
# BlockBridge AI Environment Configuration
# ==========================================
# Copy this file to .env before starting the server.
# NEVER commit real API keys or secrets to version control.

# --- App Configuration ---
NODE_ENV=development
VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME="BlockBridge AI"
VITE_DEMO_MODE=true

# --- Backend API (FastAPI) ---
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# --- Optional AI Engine (Leave empty to use deterministic fallback) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional Supabase / Database (Leave empty for local demo storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key should ONLY be used in server-side migrations/admin tasks:
SUPABASE_SERVICE_ROLE_KEY=
